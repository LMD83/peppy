# Convex backend environment variables.
# Set on your deployment with:
#   npx convex env set --from-file .env.convex
#   npx convex env set --from-file .env.convex --prod   # production
#
# Copy and fill in real values:
#   cp .env.convex.example .env.convex

# SumUp secret API key — server-side only (see convex/SUMUP.md)
SUMUP_SECRET_KEY=replace-with-sumup-sandbox-secret-key

# Optional: SumUp webhook signing secret (when webhook handler is implemented)
# SUMUP_WEBHOOK_SECRET=

# Auth keys — generated by `npx @convex-dev/auth` when auth is set up
# JWT_PRIVATE_KEY=
# JWKS=

# Web push (reminders). Without both keys the reminder sweep computes the right
# plan and sends nothing, and the Reminders tab says so plainly rather than
# showing a switch that lies. Generate a pair with:
#   npx web-push generate-vapid-keys
# The public key is also served to the browser through the remind query, so it
# is not a secret; the private key is.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
#
# Email (optional second channel). Same reminder words, sent once.
# RESEND_API_KEY=
# REMIND_EMAIL_FROM=Timento <onboarding@resend.dev>
