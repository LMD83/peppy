# Committed production build defaults — PUBLIC values only (NEXT_PUBLIC_* is
# always exposed in the client bundle; never put secrets here).
#
# Vercel dashboard env vars override this file (process.env wins in Next's
# load order). Once the Convex production deploy key is wired into Vercel
# (see DEPLOY.md), `npx convex deploy --cmd 'npm run build'` injects the
# canonical prod NEXT_PUBLIC_CONVEX_URL automatically and this fallback is
# ignored.

# Store backend — the project's existing Convex DEV deployment, used as the
# fallback until the prod deployment has functions pushed (DEPLOY.md step 2).
NEXT_PUBLIC_CONVEX_URL=https://dependable-vulture-853.eu-west-1.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://dependable-vulture-853.eu-west-1.convex.site

# Timento runs in demo mode (in-memory backend, demo fixtures) until the
# tm_* functions exist on the production Convex deployment. Flip to 0 (or
# delete) after DEPLOY.md step 2.
NEXT_PUBLIC_TIMENTO_DEMO=1
